class Book:
    def __init__(self, title, author):
        self.__title = title
        self.__author = author
        self.__status = "доступна"
    
    def get_title(self):
        return self.__title
    
    def get_author(self):
        return self.__author
    
    def get_status(self):
        return self.__status
    
    def set_status(self, new_status):
        if new_status in ["доступна", "выдана"]:
            self.__status = new_status
    
    def display_info(self):
        print(f"Книга: '{self.__title}', Автор: {self.__author}, Статус: {self.__status}")

class Person:
    def __init__(self, name):
        self.__name = name
    
    def get_name(self):
        return self.__name
    
    def display_info(self):
        print(f"Имя: {self.__name}")

class User(Person):
    def __init__(self, name):
        super().__init__(name)
        self.__taken_books = []
    
    def take_book(self, book):
        if book in self.__taken_books:
            print(f"Книга '{book.get_title()}' уже у пользователя {self.get_name()}")
            return
        
        if book.get_status() == "доступна":
            self.__taken_books.append(book)
            print(f"Книга '{book.get_title()}' выдана пользователю {self.get_name()}")
            book.set_status("выдана")
        else:
            print(f"Книга '{book.get_title()}' уже выдана")
    
    def return_book(self, book):
        if book in self.__taken_books:
            self.__taken_books.remove(book)
            print(f"Книга '{book.get_title()}' возвращена")
            book.set_status("доступна")
        else:
            print(f"У пользователя {self.get_name()} нет книги '{book.get_title()}'")
    
    def show_my_books(self):
        if not self.__taken_books:
            print(f"У пользователя {self.get_name()} нет книг")
            return
        
        print(f"Книги пользователя {self.get_name()}:")
        for i, book in enumerate(self.__taken_books, 1):
            print(f"{i}. {book.get_title()}")

class Librarian(Person):
    def __init__(self, name):
        super().__init__(name)

class Library:
    def __init__(self):
        self.__books = []
        self.__users = []
        self.__librarians = []
        self.load_data()
    
    def add_book(self, title, author):
        for book in self.__books:
            if book.get_title() == title and book.get_author() == author:
                return f"Ошибка! Книга '{title}' уже есть в библиотеке"
        
        new_book = Book(title, author)
        self.__books.append(new_book)
        return f"Книга '{title}' добавлена"
    
    def remove_book(self, title):
        for book in self.__books:
            if book.get_title() == title:
                if book.get_status() == "выдана":
                    return f"Ошибка! Книга '{title}' выдана, нельзя удалить"
                self.__books.remove(book)
                return f"Книга '{title}' удалена"
        return f"Ошибка! Книга '{title}' не найдена"
    
    def find_book(self, title):
        for book in self.__books:
            if book.get_title() == title:
                return book
        return None
    
    def register_user(self, name):
        for user in self.__users:
            if user.get_name() == name:
                return f"Ошибка! Пользователь '{name}' уже существует"
        
        new_user = User(name)
        self.__users.append(new_user)
        return f"Пользователь '{name}' зарегистрирован"
    
    def show_all_books(self):
        if not self.__books:
            print("В библиотеке нет книг")
            return
        
        print("Все книги в библиотеке:")
        for book in self.__books:
            book.display_info()
    
    def show_all_users(self):
        if not self.__users:
            print("Нет зарегистрированных пользователей")
            return
        
        print("Зарегистрированные пользователи:")
        for user in self.__users:
            print(f"- {user.get_name()}")
    
    def set_current_librarian(self, name):
        for librarian in self.__librarians:
            if librarian.get_name() == name:
                return f"Библиотекарь '{name}' уже в системе"
        
        self.__librarians = [Librarian(name)]
        return f"Вы вошли как библиотекарь: {name}"
    
    def save_data(self):
        with open("books.txt", "w", encoding="utf-8") as f:
            for book in self.__books:
                f.write(f"{book.get_title()};{book.get_author()};{book.get_status()}\n")
        
        with open("users.txt", "w", encoding="utf-8") as f:
            for user in self.__users:
                book_titles = []
                for book in user._User__taken_books:
                    book_titles.append(book.get_title())
                books_str = ",".join(book_titles)
                f.write(f"{user.get_name()};{books_str}\n")
        
        with open("librarians.txt", "w", encoding="utf-8") as f:
            for librarian in self.__librarians:
                f.write(f"{librarian.get_name()}\n")
        
        print("Данные сохранены")
    
    def load_data(self):
        try:
            with open("books.txt", "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line:
                        title, author, status = line.split(";")
                        book = Book(title, author)
                        book.set_status(status)
                        self.__books.append(book)
        except FileNotFoundError:
            pass
        
        try:
            with open("users.txt", "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line:
                        name, books_str = line.split(";")
                        user = User(name)
                        self.__users.append(user)
                        
                        if books_str:
                            for book_title in books_str.split(","):
                                book = self.find_book(book_title)
                                if book:
                                    user._User__taken_books.append(book)
                                    book.set_status("выдана")
        except FileNotFoundError:
            pass
        
        try:
            with open("librarians.txt", "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line:
                        librarian = Librarian(line)
                        self.__librarians.append(librarian)
        except FileNotFoundError:
            pass

