import csv

data = [["Имя","Возраст","Город","Должность"],
        ["Сергеев",45,"Москва","Директор"],
        ["Орлова",31,"СПб","Дизайнер"],
        ["Кириллов",27,"Нск","Разработчик"],
        ["Громова",39,"Екб","Менеджер"]]

with open('csv_file.csv', 'w', newline='', encoding='utf-8') as f:
    csv.writer(f).writerows(data)

try:
    with open('csv_file.csv', 'r', encoding='utf-8') as f:
        for row in csv.DictReader(f):
            try:
                if int(row['Возраст']) > 30:
                    print(row['Имя'])
            except:
                pass
except:
    print("Файл не найден")
